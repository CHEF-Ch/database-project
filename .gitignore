# Word/Office 临时锁文件
~$*.docx
~$*.pptx
~$*.xlsx
*.tmp
*.wbk

# SQL Server 数据库文件（不进仓库）
*.mdf
*.ldf
*.ndf
*.bak

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 本地环境变量（含数据库密码，不进仓库）
.env

# 系统 / 编辑器
Thumbs.db
Desktop.ini
.DS_Store
.vs/
.idea/
*.suo

# 日志
*.log
logs/

# 老师下发的任务讲解材料（原始材料，不进仓库）
任务讲解/

# 例外：result/ 下脱敏后的日志样例需要入库（⑦ 的交付物）
!result/*.log
