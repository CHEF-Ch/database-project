# =============================================================================
# Web 应用环境变量示例
# 复制为 .env（或用系统环境变量）后按本机情况修改；.env 已在 .gitignore 中，
# 不要把真实密码提交进仓库。
# =============================================================================

# Flask session 签名密钥：改成随机串（生产环境必须换）
SECRET_KEY=replace-with-a-random-string

# ---------- 数据库连接 ----------
# 数据库认证方式：
#   trusted = Windows 信任连接（默认，无需密码，开箱即用）
#   sql     = 每个应用角色使用各自的受限 SQL 登录（需先跑 scripts/enable-mixed-auth.ps1）
DB_AUTH=trusted
DB_SERVER=.\SQLEXPRESS
DB_NAME=MilkTeaShop_v01
DB_DRIVER=ODBC Driver 18 for SQL Server

# DB_AUTH=sql 时必填：与 sql/app_login.sql 中的示例密码一致
# 命名规则：DB_PWD_ + 登录名大写
# DB_PWD_LOGIN_CLERK=
# DB_PWD_LOGIN_CUSTOMER=
# DB_PWD_LOGIN_MAKER=
# DB_PWD_LOGIN_STOCK=
# DB_PWD_LOGIN_MANAGER=

# ---------- 用户存储 ----------
#   config = v1.0：配置内 demo 账号（app/demo_users.py）
#   db     = v2.0：app_user 表（尚未创建）
USER_STORE=config
