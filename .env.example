# =============================================================================
# Web 应用环境变量示例
# 复制为 .env（或用系统环境变量）后按本机情况修改；.env 已在 .gitignore 中，
# 不要把真实密码提交进仓库。
# =============================================================================

# Flask session 签名密钥：**留空即可**——程序会在启动时随机生成（每进程一个，重启后旧 session 失效）。
# 只有两种情况需要显式设置：① 多 worker / 多进程部署（必须同一个密钥）；② 希望重启后会话仍保留。
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
# SECRET_KEY=

# ---------- 数据库连接 ----------
# 数据库认证方式：
#   trusted = Windows 信任连接（默认，无需密码，开箱即用）
#   sql     = 每个应用角色使用各自的受限 SQL 登录（需先跑 scripts/enable-mixed-auth.ps1）
DB_AUTH=trusted
DB_SERVER=.\SQLEXPRESS
DB_NAME=MilkTeaShop_v01
DB_DRIVER=ODBC Driver 18 for SQL Server
# 单条 SQL 的锁等待/查询超时（秒）；0 表示不限制
DB_QUERY_TIMEOUT=15

# DB_AUTH=sql 时必填：与 sql/app_login.sql 中的示例密码一致
# 命名规则：DB_PWD_ + 登录名大写
# DB_PWD_LOGIN_CLERK=
# DB_PWD_LOGIN_CUSTOMER=
# DB_PWD_LOGIN_MAKER=
# DB_PWD_LOGIN_STOCK=
# DB_PWD_LOGIN_MANAGER=
# DB_PWD_LOGIN_APP=        # 写事务账户（role_app）

# ---------- 用户存储 ----------
#   config = v1.0：配置内 demo 账号（app/demo_users.py）
#   db     = v2.0：app_user 表（尚未创建）
USER_STORE=config
